# Copia este fichero como .env y rellena solo los canales que uses.
# .env nunca se sube al repo (está en .gitignore).

# --- ntfy (push al móvil) ---
# El nombre del tema hace de contraseña: quien lo sepa puede leer tus avisos.
NTFY_TOPIC=

# --- correo (Gmail) ---
# EMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google, no tu contraseña.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=
